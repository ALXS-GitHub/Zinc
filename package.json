{
  "name": "@zinc/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Zinc, le design système des interfaces d'app : tokens, moteur de thème, couche shadcn et composants React.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./zinc.css": "./src/styles/zinc.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./shadcn.css": "./src/tailwind/shadcn.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "src",
    "tokens.json",
    "docs"
  ],
  "scripts": {
    "tokens": "bun scripts/build-tokens.ts",
    "tokens:check": "bun scripts/build-tokens.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "demo": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:showcase": "bun scripts/build-showcase.tsx",
    "build": "bun run tokens:check && bun run typecheck && bun test && bun run build:demo && bun run build:showcase",
    "shots": "bun scripts/screenshots.ts"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.561.0",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "puppeteer-core": "^25.19.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
